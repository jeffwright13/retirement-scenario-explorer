{
    "early-retirement-baseline": {
      "metadata": {
        "title": "Early Retirement Baseline - Tax Optimization Window",
        "description": "Modeling a 7-year tax optimization strategy before full Social Security benefits",
        "tags": ["early-retirement", "tax-optimization", "baseline-scenario"]
      },
      "plan": {
        "monthly_expenses": 6500,
        "duration_months": 300,
        "inflation_schedule": "realistic_inflation",
        "stop_on_shortfall": true
      },
      "income": [
        {
          "name": "Full Social Security",
          "amount": 3400,
          "start_month": 84,
          "notes": "Full retirement benefits at age 67 -- no SS income before this; that's the tax-optimization window. See 'early-claiming-comparison' for the early-claim alternative."
        }
      ],
      "assets": [
        {
          "name": "High-Yield Savings",
          "type": "taxable",
          "balance": 125000,
          "min_balance": 30000,
          "return_schedule": "savings_rate",
          "market_dependent": false,
          "notes": "Emergency fund and immediate liquidity"
        },
        {
          "name": "Brokerage Investment",
          "type": "taxable", 
          "balance": 500000,
          "return_schedule": "market_growth",
          "market_dependent": true,
          "notes": "Taxable investment account"
        },
        {
          "name": "Traditional IRA",
          "type": "tax_deferred",
          "balance": 300000,
          "return_schedule": "ira_growth",
          "market_dependent": true,
          "notes": "Subject to RMDs at 73, tax optimization target"
        },
        {
          "name": "Roth IRA",
          "type": "tax_free",
          "balance": 15000,
          "return_schedule": "roth_growth",
          "market_dependent": true,
          "notes": "Tax-free growth and withdrawals"
        }
      ],
      "order": [
        {
          "account": "High-Yield Savings",
          "order": 1,
          "notes": "Use cash first for immediate needs"
        },
        {
          "account": "Brokerage Investment", 
          "order": 2,
          "weight": 0.6,
          "notes": "Primary withdrawal source - harvest gains strategically"
        },
        {
          "account": "Traditional IRA",
          "order": 2, 
          "weight": 0.4,
          "notes": "Convert to Roth during low-income years (2026-2032)"
        },
        {
          "account": "Roth IRA",
          "order": 3,
          "notes": "Last resort - preserve tax-free growth"
        }
      ],
      "rate_schedules": {
        "realistic_inflation": {"type": "fixed", "rate": 0.035},
        "savings_rate": {"type": "fixed", "rate": 0.037},
        "market_growth": {"type": "fixed", "rate": 0.065},
        "ira_growth": {"type": "fixed", "rate": 0.062},
        "roth_growth": {"type": "fixed", "rate": 0.07}
      }
    },

